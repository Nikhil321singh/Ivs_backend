# ==============================
# SERVER
# ==============================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ==============================
# DATABASE
# ==============================
MONGODB_URI=mongodb://127.0.0.1:27017/ivs_mobile_app

# ==============================
# CORS
# ==============================
CLIENT_URL=http://localhost:3000

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRY=30d

# ==============================
# MSG91 (Flow API — OTP is generated and verified by us, delivered via a
# Flow template. The template's variable for the OTP value must be var1.)
# ==============================
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=5

# ==============================
# Aadhaar e-KYC (GREST wrapper -> Paysprint)
# ==============================
GREST_WRAPPER_BASE_URL=https://grest.agbe.in/api
GREST_WRAPPER_AUTH_TOKEN=your_grest_wrapper_auth_token
PAYSPRINT_PARTNER_ID=your_paysprint_partner_id
PAYSPRINT_AUTHORISED_KEY=your_paysprint_authorised_key

# ==============================
# IMEI blocklist verification (C-DOT CEIR / Sanchar Saathi)
# ==============================
CDOT_IVS_BASE_URL=https://ivs.sancharsaathi.gov.in/api
CDOT_IVS_USERNAME=your_cdot_ivs_username
CDOT_IVS_PASSWORD=your_cdot_ivs_password

# ==============================
# Razorpay (token wallet top-ups)
# Tokens are credited ONLY from the signature-verified webhook / verify call —
# never from the client callback alone. Set the webhook secret to the value
# configured in the Razorpay dashboard webhook.
# ==============================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# ==============================
# Device diagnosis (third-party provider — contract TBD)
# ==============================
DIAGNOSE_BASE_URL=
DIAGNOSE_API_KEY=

# ==============================
# DEFAULTS
# ==============================
DEFAULT_COUNTRY_CODE=+91

# ==============================
# FILE UPLOAD
# ==============================
UPLOAD_MAX_SIZE_MB=5

# ==============================
# STORAGE (image/file uploads)
# driver selects the backend: "cloudinary" (default) or "s3".
# Swap the driver + fill the matching credentials block below to migrate
# with no code changes.
# ==============================
STORAGE_DRIVER=cloudinary
STORAGE_IMAGE_FOLDER=ivs/profile

# --- Cloudinary (STORAGE_DRIVER=cloudinary) ---
# Find these under Settings -> API Keys in the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- AWS S3 (STORAGE_DRIVER=s3) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
