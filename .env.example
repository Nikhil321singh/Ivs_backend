# ==============================
# SERVER
# ==============================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ==============================
# DATABASE
# ==============================
# NEVER put real credentials in this file — it is committed to git.
# Real values belong in .env, which is gitignored.
MONGODB_URI=mongodb://127.0.0.1:27017/ivs_mobile_app

# ==============================
# CORS
# ==============================
CLIENT_URL=http://localhost:3000
# Origin(s) of the admin console (separate ivs-admin-frontend repo, on Vercel).
# Comma-separated — Vercel gives each preview deployment its own hostname, so
# list production alongside any preview you test against. Origins only: scheme
# + host, no path, no trailing slash.
# Not needed while vercel.json proxies /api/v1/admin to this API server-side
# (the browser then sees same-origin requests), but harmless to set and
# required the moment the console calls the API directly.
ADMIN_URL=https://ivs-admin-frontend.vercel.app,http://localhost:5173

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRY=30d

# ==============================
# ADMIN PORTAL (served at /admin)
# ==============================
# Optional: falls back to JWT_ACCESS_SECRET. Set a distinct value in production
# so an admin session and a user session don't share a signing key. Admin tokens
# carry a typ="admin" claim that user tokens never have, so user tokens are
# rejected on /admin routes either way.
ADMIN_JWT_SECRET=replace_with_a_long_random_admin_secret
ADMIN_JWT_EXPIRY=12h
# Used only by `npm run seed:admin`. Omit ADMIN_PASSWORD to have a strong one
# generated and printed once.
ADMIN_EMAIL=admin@grest.in
ADMIN_PASSWORD=

# ==============================
# MSG91 (Flow API — OTP is generated and verified by us, delivered via a
# Flow template. The template's variable for the OTP value must be var1.)
# ==============================
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=5

# ==============================
# Aadhaar e-KYC (GREST wrapper -> Paysprint)
# ==============================
GREST_WRAPPER_BASE_URL=https://grest.agbe.in/api
GREST_WRAPPER_AUTH_TOKEN=your_grest_wrapper_auth_token
PAYSPRINT_PARTNER_ID=your_paysprint_partner_id
PAYSPRINT_AUTHORISED_KEY=your_paysprint_authorised_key

# --- Aadhaar test mode (NON-PRODUCTION) ---
# Set AADHAAR_TEST_MODE=true to let the sandbox numbers below verify with a
# fixed OTP without ever calling Paysprint/UIDAI — lets clients exercise the
# full KYC flow before provider credentials are live. Any other Aadhaar still
# goes to the real provider. Leave unset (or anything but "true") to disable.
# The server logs a loud warning at boot while this is on.
# Test numbers are also REUSABLE: their stored hash is salted per-user, so any
# number of accounts can register with the same sandbox Aadhaar. Real Aadhaar
# numbers keep the one-account-per-Aadhaar guarantee.
AADHAAR_TEST_MODE=false
AADHAAR_TEST_OTP=123456
AADHAAR_TEST_NUMBERS=999999990019

# ==============================
# IMEI blocklist verification (C-DOT CEIR / Sanchar Saathi)
# ==============================
CDOT_IVS_BASE_URL=https://ivs.sancharsaathi.gov.in/api
CDOT_IVS_USERNAME=your_cdot_ivs_username
CDOT_IVS_PASSWORD=your_cdot_ivs_password

# ==============================
# Razorpay (token wallet top-ups)
# Tokens are credited ONLY from the signature-verified webhook / verify call —
# never from the client callback alone. Set the webhook secret to the value
# configured in the Razorpay dashboard webhook.
# ==============================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# ==============================
# Device diagnosis (third-party provider — contract TBD)
# ==============================
DIAGNOSE_BASE_URL=
DIAGNOSE_API_KEY=

# ==============================
# DEFAULTS
# ==============================
DEFAULT_COUNTRY_CODE=+91

# ==============================
# FILE UPLOAD
# ==============================
UPLOAD_MAX_SIZE_MB=5

# ==============================
# STORAGE (image/file uploads)
# driver selects the backend: "cloudinary" (default) or "s3".
# Swap the driver + fill the matching credentials block below to migrate
# with no code changes.
# ==============================
STORAGE_DRIVER=cloudinary
STORAGE_IMAGE_FOLDER=ivs/profile

# --- Cloudinary (STORAGE_DRIVER=cloudinary) ---
# Find these under Settings -> API Keys in the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- AWS S3 (STORAGE_DRIVER=s3) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- DigiLocker Aadhaar verification (SprintVerify) --------------------------
# UAT base URL. The published docs still say uat.paysprint.in, but that host now
# returns 503 telling you to use sit.paysprint.in — use the latter.
#   UAT   https://sit.paysprint.in/sprintverify-uat/api/v1/verification
#   PROD  https://api.verifya2z.com/api/v1/verification
PAYSPRINT_BASE_URL=https://sit.paysprint.in/sprintverify-uat/api/v1/verification

# Signs the JWT (the docs call this "JWT KEY"). Already set for production.
PAYSPRINT_AUTHORISED_KEY=

# The `Authorisedkey` REQUEST HEADER — a different value from the JWT key, even
# though the names are nearly identical. Falls back to PAYSPRINT_AUTHORISED_KEY
# when unset. Ask Paysprint for the production value.
PAYSPRINT_AUTHORISEDKEY=

# Where DigiLocker returns the user. We append ?refid=<refid> ourselves, so the
# callback works regardless of what the provider adds. Must be registered with
# the provider and publicly reachable.
DIGILOCKER_REDIRECT_URL=https://business.grest.in/api/v1/user/aadhaar/digilocker/callback
DIGILOCKER_APP_RETURN_URL=http://localhost:3000/kyc/aadhaar
DIGILOCKER_SESSION_TTL_MINUTES=15
